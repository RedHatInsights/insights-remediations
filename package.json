{
  "name": "insights-remediations",
  "version": "1.2.0",
  "description": "Generator of automated remediations for Red Hat Insights",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:RedHatInsights/insights-remediations.git"
  },
  "author": "Jozef Hartinger",
  "license": "Apache-2.0",
  "dependencies": {
    "@godaddy/terminus": "4.12.1",
    "@project-kessel/kessel-sdk": "3.10.0",
    "app-common-js": "2.2.4",
    "bluebird": "3.7.2",
    "body-parser": "1.20.6",
    "clean-modules": "3.1.1",
    "cls-bluebird": "2.1.0",
    "dedent-js": "1.0.1",
    "etag": "1.8.1",
    "express": "4.22.2",
    "express-http-context": "1.2.5",
    "express-prom-bundle": "5.1.5",
    "graphql-request": "2.0.0",
    "ioredis": "6.0.0",
    "js-yaml": "4.3.2",
    "jszip": "3.10.1",
    "lodash": "4.18.1",
    "mustache": "3.2.1",
    "openapi-default-setter": "12.1.3",
    "openapi-request-coercer": "12.1.3",
    "openapi-request-validator": "12.1.3",
    "openapi-response-validator": "12.1.3",
    "openapi-schema-validator": "12.1.3",
    "p-limit": "3.1.0",
    "pg": "8.21.0",
    "pino": "8.21.0",
    "pino-cloudwatch": "0.7.0",
    "pino-http": "8.6.1",
    "pino-pretty": "13.1.3",
    "prom-client": "11.5.3",
    "request": "2.88.2",
    "request-promise": "4.2.6",
    "sequelize": "6.37.8",
    "sequelize-cli": "6.6.5",
    "swagger-ui-express": "5.0.1",
    "unleash-client": "6.11.0",
    "urijs": "1.19.11"
  },
  "devDependencies": {
    "eslint": "9.2.0",
    "eslint-plugin-jest": "29.15.2",
    "globals": "17.6.0",
    "gulp": "5.0.1",
    "gulp-cli": "3.1.0",
    "jest": "29.7.0",
    "jest-junit": "14.0.1",
    "nodemon": "2.0.22",
    "npm-run-all2": "6.2.6",
    "should": "13.2.3",
    "sinon": "19.0.5",
    "speccy": "0.11.0",
    "supertest": "7.2.2"
  },
  "overrides": {
    "aws-sdk": {
      "uuid": "^11.1.1"
    },
    "sequelize": {
      "uuid": "^11.1.1"
    },
    "jest-junit": {
      "uuid": "^11.1.1"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    },
    "ajv": {
      "fast-uri": "3.1.7"
    },
    "loader-utils": "^3.2.1",
    "tough-cookie": "^4.1.3",
    "pino-cloudwatch": {
      "async": "^3.2.6"
    },
    "os-locale": {
      "execa": "^9.5.1"
    },
    "cls-hooked": {
      "semver": "^5.7.2"
    },
    "request": {
      "form-data": "2.5.6"
    },
    "qs": "^6.16.0"
  },
  "scripts": {
    "build": "gulp build",
    "coverage": "NODE_ENV=test npm run db:ims && jest -i --coverage",
    "db:ims": "npm-run-all db:init db:migrate db:seed",
    "db:wims": "npm-run-all db:wait db:init db:migrate db:seed",
    "db:create": "sequelize db:create",
    "db:drop": "sequelize db:drop",
    "db:hello": "sequelize",
    "db:init": "sequelize db:drop; sequelize db:create",
    "db:migrate": "sequelize db:migrate",
    "db:migrate:undo": "sequelize db:migrate:undo",
    "db:migrate:undo:all": "sequelize db:migrate:undo:all",
    "db:seed": "sequelize db:seed:all",
    "db:wait": "node src/db/wait.js",
    "lint": "npm-run-all lint:js lint:openapi",
    "lint:js": "eslint *.js db src",
    "lint:yaml": "yamllint src/api/openapi.yaml",
    "lint:openapi": "speccy lint src/api/openapi.yaml && node src/api/lint.js",
    "prod": "NODE_ENV=production node src/app.js",
    "start": "NODE_ENV=development nodemon --watch src  -e js,yaml src/app.js",
    "test": "NODE_ENV=test npm run db:ims && LOG_LEVEL=fatal jest -i --coverage",
    "test:ci": "NODE_ENV=test npm run db:wims && LOG_LEVEL=fatal jest -i --coverage",
    "test:unit": "NODE_ENV=test jest -i --testMatch='**/?(*.)+(unit).js'",
    "test:dc": "docker-compose -f build/docker-compose-unit_test.yml up --build --exit-code-from remediations-api",
    "test:dc-down": "docker-compose -f build/docker-compose-unit_test.yml down",
    "test:contract": "NODE_ENV=test jest -i --testMatch='**/?(*.)+(contract).js'",
    "test:kessel": "node scripts/test-kessel-migration.js",
    "kessel:start": "docker-compose -f docker-compose.kessel.yml up -d",
    "kessel:stop": "docker-compose -f docker-compose.kessel.yml down",
    "verify": "npm-run-all lint coverage"
  }
}
